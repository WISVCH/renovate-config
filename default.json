{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared default Renovate policy for WISVCH repositories.",

  // Keep Renovate's maintained baseline while making our deviations explicit below.
  "extends": ["config:recommended"],

  // Apply Renovate's configuration-migration suggestions and rebase stale PRs.
  "configMigration": true,
  "rebaseWhen": "behind-base-branch",

  // Make dependency-update PRs easy to find across every enrolled repository.
  "labels": ["dependencies"],

  // Merge normal eligible updates only overnight in local time. Platform automerge
  // must be off, otherwise GitHub can merge a PR outside Renovate's schedule.
  "timezone": "Europe/Amsterdam",
  "platformAutomerge": false,
  "automergeSchedule": ["* 2-5 * * *"],

  // Inline equivalent of :automergeStableNonMajor: only stable (non-0.x)
  // dependency minor and patch updates may be merged automatically.
  "packageRules": [
    {
      "automerge": true,
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor", "patch"]
    }
  ],

  // GitHub Dependabot alerts bypass normal schedules and are automerged as soon
  // as the hourly self-hosted Renovate job next runs and required checks pass.
  "vulnerabilityAlerts": {
    "automerge": true,
    "automergeSchedule": ["at any time"]
  },

  // https://docs.renovatebot.com/modules/manager/nix/
  "nix": {
    "enabled": true
  }
  
}
